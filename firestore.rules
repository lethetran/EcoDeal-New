rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidDeal(data) {
      return data.productName is string && data.productName.size() > 0
        && data.salePrice is number && data.salePrice >= 0
        && data.dealPercentage is number && data.dealPercentage >= 0 && data.dealPercentage <= 100
        && data.quantity is number && data.quantity >= 0;
    }

    function isValidOrder(data) {
      return data.items is list && data.items.size() > 0
        && data.subTotal is number && data.subTotal >= 0
        && data.shippingFee is number && data.shippingFee >= 0
        && data.discountAmount is number && data.discountAmount >= 0
        && data.total is number && data.total >= 0
        && data.total == data.subTotal + data.shippingFee - data.discountAmount;
    }

    function isValidReview(data) {
      return data.dealId is string && data.dealId.size() > 0
        && data.sellerUid is string && data.sellerUid.size() > 0
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000;
    }

    function isValidSellerReply(data) {
      return data.sellerReply is string && data.sellerReply.size() <= 1000;
    }

    match /flashDeals/{dealId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && isValidDeal(request.resource.data);

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && isValidDeal(request.resource.data);

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /userCarts/{userId}/items/{itemId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isValidOrder(request.resource.data);

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if request.auth != null
        && reviewId == (request.resource.data.dealId + '_' + request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sellerUid != request.auth.uid
        && isValidReview(request.resource.data);

      // Khách sửa lại đánh giá của chính mình
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.dealId == resource.data.dealId
        && request.resource.data.sellerUid == resource.data.sellerUid
        && isValidReview(request.resource.data);

      // Shop (chủ bài đăng) phản hồi đánh giá — chỉ được đổi sellerReply/sellerReplyAt
      allow update: if request.auth != null
        && resource.data.sellerUid == request.auth.uid
        && request.resource.data.dealId == resource.data.dealId
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.comment == resource.data.comment
        && isValidSellerReply(request.resource.data);

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /userProfiles/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }
  }
}
