rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidDeal(data) {
      return data.productName is string && data.productName.size() > 0
        && data.salePrice is number && data.salePrice >= 0
        && data.dealPercentage is number && data.dealPercentage >= 0 && data.dealPercentage <= 100
        && data.quantity is number && data.quantity >= 0;
    }

    function isValidOrder(data) {
      return data.items is list && data.items.size() > 0
        && data.subTotal is number && data.subTotal >= 0
        && data.shippingFee is number && data.shippingFee >= 0
        && data.discountAmount is number && data.discountAmount >= 0
        && data.total is number && data.total >= 0
        && data.total == data.subTotal + data.shippingFee - data.discountAmount;
    }

    function isValidReview(data) {
      return data.dealId is string && data.dealId.size() > 0
        && data.sellerUid is string && data.sellerUid.size() > 0
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000;
    }

    function isValidReply(data) {
      return data.uid is string && data.uid.size() > 0
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000;
    }

    function isValidNotification(data) {
      return data.uid is string && data.uid.size() > 0
        && data.fromUid is string && data.fromUid.size() > 0
        && data.uid != data.fromUid
        && data.type is string
        && data.message is string && data.message.size() > 0 && data.message.size() <= 500
        && data.read == false;
    }

    function isValidWithdrawal(data) {
      return data.uid is string && data.uid.size() > 0
        && data.amount is number && data.amount > 0
        && data.bankAccountNumber is string && data.bankAccountNumber.size() > 0
        && data.bankName is string && data.bankName.size() > 0
        && data.accountHolderName is string && data.accountHolderName.size() > 0
        && data.status == 'pending';
    }

    match /flashDeals/{dealId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && isValidDeal(request.resource.data);

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && isValidDeal(request.resource.data);

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /userCarts/{userId}/items/{itemId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isValidOrder(request.resource.data);

      // Người mua đọc đơn của mình; người bán (có mặt trong sellerUids) đọc để tính doanh thu.
      allow read: if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || (resource.data.sellerUids is list && request.auth.uid in resource.data.sellerUids)
        );

      // Người mua báo cáo vấn đề đơn hàng — chỉ được bật cờ disputed (một chiều), không sửa gì khác.
      // Việc trừ tiền/tạo trạng thái paid/settledAt chỉ do Cloud Function (Admin SDK) thực hiện,
      // Admin SDK bỏ qua rules nên không cần thêm allow update cho các field đó ở đây.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disputed', 'disputeReason', 'disputedAt', 'updatedAt'])
        && request.resource.data.disputed == true;

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;

      // Mỗi lần gửi tạo 1 bình luận mới (ID tự sinh), không giới hạn 1 bình luận / khách / bài đăng.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sellerUid != request.auth.uid
        && isValidReview(request.resource.data);

      // Khách sửa lại 1 bình luận cụ thể của chính mình (nếu UI cho sửa)
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.dealId == resource.data.dealId
        && request.resource.data.sellerUid == resource.data.sellerUid
        && isValidReview(request.resource.data);

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Thread bình luận qua lại giữa khách (chủ đánh giá) và shop (chủ bài đăng).
      // Mỗi tin là 1 document riêng — không ai ghi đè được tin của người khác.
      match /replies/{replyId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && isValidReply(request.resource.data)
          && (
            get(/databases/$(database)/documents/reviews/$(reviewId)).data.uid == request.auth.uid
            || get(/databases/$(database)/documents/reviews/$(reviewId)).data.sellerUid == request.auth.uid
          );

        allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && isValidNotification(request.resource.data);

      // Chỉ người nhận được đánh dấu đã đọc, không được sửa nội dung thông báo.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.message == resource.data.message
        && request.resource.data.dealId == resource.data.dealId
        && request.resource.data.read is bool;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /userProfiles/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /withdrawalRequests/{requestId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isValidWithdrawal(request.resource.data);

      // Huỷ yêu cầu khi còn "pending" — không tự đổi sang completed/rejected được (chỉ xử lý thủ công
      // qua Firebase Console / Admin SDK, tức bỏ qua rules).
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.status == 'cancelled';

      allow delete: if false;
    }

    // Cấu hình nền tảng (vd. commissionRate) — chỉnh qua Firebase Console, client chỉ đọc.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
