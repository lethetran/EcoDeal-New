# Biến môi trường cho các API route trong /api (chạy trên Vercel, KHÔNG dùng REACT_APP_ prefix
# vì các giá trị này không được lộ ra bundle phía trình duyệt).
# Cấu hình thật ở: Vercel Dashboard > Project > Settings > Environment Variables.
# KHÔNG commit file .env chứa giá trị thật lên git.

# --- SePay (my.sepay.vn > Thông tin đơn vị) ---
SEPAY_MERCHANT_ID=SP-LIVE-XXXXXXX
SEPAY_SECRET_KEY=spsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEPAY_ENV=sandbox

# --- Firebase Admin (Firebase Console > Project Settings > Service accounts > Generate new private key) ---
FIREBASE_PROJECT_ID=ecodeal-5e9fe
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ecodeal-5e9fe.iam.gserviceaccount.com
# Dán nguyên private_key từ file JSON tải về, giữ dạng 1 dòng với \n (Vercel sẽ tự escape khi paste vào UI).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- App ---
# Domain thật của app, dùng để build success_url/error_url/cancel_url gửi cho SePay.
PUBLIC_APP_URL=https://ecodeal.vercel.app
